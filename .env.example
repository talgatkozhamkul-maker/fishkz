# Шаблон переменных окружения. Скопируйте в .env.local и заполните значениями.
# .env.local в git не попадает (см. .gitignore). Секреты — только в .env.local.

# Публичные ключи Supabase (безопасны для клиента).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Строка подключения к БД — нужна только для запуска миграций локально.
# Берётся в Supabase: Connect → Session pooler. Это СЕКРЕТ, не коммитить.
DATABASE_URL=
